
{
  "manifest_version": 3,
  "name": "Transformer",
  "version": "0.1.0",
  "description": "An AI-powered browser extension that transforms webpage UIs using natural-language instructions.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/inspector.bundle.js", "content/content.js"]
    }
  ]
}
